rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn() &&
        (request.auth.uid == data.managedUserId ||
          request.auth.uid == data.managerUserId);
    }

    function isCommitmentParticipant(data) {
      return signedIn() &&
        (request.auth.uid == data.ownerUserId ||
          request.auth.uid in data.managerUserIds);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /managerInvitations/{invitationId} {
      allow read: if isParticipant(resource.data);

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.managedUserId &&
        request.resource.data.managedUserId != request.resource.data.managerUserId &&
        request.resource.data.status == 'pending';

      allow update: if isParticipant(resource.data) &&
        resource.data.status == 'pending' &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.managedUserId == resource.data.managedUserId &&
        request.resource.data.managerUserId == resource.data.managerUserId &&
        (
          (
            request.auth.uid == resource.data.managerUserId &&
            request.resource.data.status in ['accepted', 'declined']
          ) ||
          (
            request.auth.uid == resource.data.managedUserId &&
            request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if false;
    }

    match /managerRelationships/{relationshipId} {
      allow read: if isParticipant(resource.data);

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.managerUserId &&
        request.resource.data.managedUserId != request.resource.data.managerUserId &&
        request.resource.data.status == 'active';

      allow update: if isParticipant(resource.data) &&
        resource.data.status == 'active' &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.managedUserId == resource.data.managedUserId &&
        request.resource.data.managerUserId == resource.data.managerUserId &&
        request.resource.data.status == 'removed';

      allow delete: if false;
    }

    match /commitments/{commitmentId} {
      allow read: if isCommitmentParticipant(resource.data);

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.ownerUserId &&
        request.resource.data.status == 'draft';

      allow update: if isCommitmentParticipant(resource.data) &&
        request.auth.uid == resource.data.ownerUserId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUserId == resource.data.ownerUserId;

      allow delete: if false;
    }

    match /commitmentVersions/{versionId} {
      allow read: if isCommitmentParticipant(resource.data);

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.ownerUserId &&
        request.resource.data.createdByUserId == request.auth.uid;

      allow update, delete: if false;
    }

    match /checkIns/{checkInId} {
      allow read: if isCommitmentParticipant(resource.data);

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.ownerUserId &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.id == checkInId &&
        request.resource.data.status == 'submitted';

      allow update: if signedIn() &&
        request.auth.uid == resource.data.ownerUserId &&
        request.auth.uid == resource.data.userId &&
        resource.data.status == 'missed' &&
        resource.data.wasMissed == true &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.commitmentId == resource.data.commitmentId &&
        request.resource.data.ownerUserId == resource.data.ownerUserId &&
        request.resource.data.managerUserIds == resource.data.managerUserIds &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.periodIndex == resource.data.periodIndex &&
        request.resource.data.periodStartsAt == resource.data.periodStartsAt &&
        request.resource.data.periodEndsAt == resource.data.periodEndsAt &&
        request.resource.data.deadline == resource.data.deadline &&
        request.resource.data.wasMissed == true &&
        request.resource.data.dueAt == resource.data.dueAt &&
        request.resource.data.missedAt == resource.data.missedAt &&
        request.resource.data.isLate == true &&
        request.resource.data.status == 'submitted';

      allow delete: if false;
    }

    match /checkInEvidence/{evidenceId} {
      allow read: if isCommitmentParticipant(resource.data);

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.ownerUserId &&
        request.resource.data.id == evidenceId &&
        request.resource.data.checkInId is string &&
        existsAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)) &&
        getAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)).data.ownerUserId == request.auth.uid &&
        request.resource.data.commitmentId == getAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)).data.commitmentId &&
        request.resource.data.periodIndex == getAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)).data.periodIndex &&
        request.resource.data.managerUserIds == getAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)).data.managerUserIds;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
